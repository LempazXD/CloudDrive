{
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft.AspNetCore": "Warning",
				"Microsoft.EntityFrameworkCore": "Warning",
				"System": "Warning"
			}
		},
		"WriteTo": [
			{ "Name": "Console" }
		]
	},
	"AllowedHosts": "*",
	"Migrations": {
		"ApplyOnStartup": false
	},
	"Jwt": {
		"Issuer": "CloudDrive",
		"Audience": "CloudDrive.Client",
		"AccessTokenLifetime": "00:15:00",
		"RefreshTokenLifetime": "30.00:00:00",
		"RefreshTokenReuseGracePeriod": "00:00:05"
	},
	"RateLimiting": {
		"Login": {
			"PermitLimit": 5,
			"Window": "00:01:00"
		},
		"Register": {
			"PermitLimit": 3,
			"Window": "00:05:00"
		},
		"ConfirmRegistration": {
			"PermitLimit": 5,
			"Window": "00:01:00"
		},
		"ForgotPassword": {
			"PermitLimit": 3,
			"Window": "00:05:00"
		},
		"ResetPassword": {
			"PermitLimit": 5,
			"Window": "00:01:00"
		},
		"ChangePassword": {
			"PermitLimit": 5,
			"Window": "00:01:00"
		},
		"ConfirmChangePassword": {
			"PermitLimit": 5,
			"Window": "00:01:00"
		}
	},
	"Registration": {
		"CodeLifetime": "00:15:00",
		"MaxAttempts": 5
	},
	"PasswordReset": {
		"CodeLifetime": "00:15:00",
		"MaxAttempts": 5
	},
	"PasswordChange": {
		"CodeLifetime": "00:15:00",
		"MaxAttempts": 5
	},
	"Identity": {
		"Lockout": {
			"MaxFailedAccessAttempts": 5,
			"DefaultLockoutTimeSpan": "00:05:00"
		},
		"Password": {
			"RequiredLength": 6,
			"RequireDigit": true,
			"RequireLowercase": true,
			"RequireUppercase": true,
			"RequireNonAlphanumeric": false,
			"RequiredUniqueChars": 1
		}
	},
	"ObjectStorage": {
		"MultipartThresholdBytes": 52428800,
		"PresignedUploadTtl": "00:15:00",
		"PresignedDownloadTtl": "00:05:00",
		"CompletionStaleAfter": "00:02:00"
	},
	"Trash": {
		"RetentionPeriod": "30.00:00:00",
		"PurgeBatchSize": 200
	}
}
